{
  "name": "wack-muzic-desktop",
  "productName": "WACK MUZIC",
  "version": "2.1.0",
  "description": "WACK MUZIC: underground music production studio. Record, beatbox to drums, Sound Lab, Auto-Tune, FX rack, song generator, 50+ instruments, mixing and export.",
  "main": "main.js",
  "author": "Jackryder4",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "sync": "node sync-web.js",
    "start": "npm run sync && electron .",
    "selftest": "npm run sync && electron . --selftest",
    "dist": "npm run sync && electron-builder --win nsis portable --publish never",
    "release": "npm run sync && electron-builder --win nsis portable --publish always"
  },
  "build": {
    "appId": "io.github.jackryder4.vistudio",
    "productName": "WACK MUZIC",
    "copyright": "Jackryder4",
    "files": [
      "main.js",
      "web/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "web/icons/icon-512.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "WACK MUZIC",
      "artifactName": "WACK-MUZIC-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "WACK-MUZIC-Portable-${version}.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Jackryder4",
        "repo": "vi-studio",
        "releaseType": "release"
      }
    ],
    "releaseInfo": {
      "releaseName": "WACK MUZIC ${version} \u2014 make it loud",
      "releaseNotesFile": "release-notes.md"
    }
  },
  "devDependencies": {
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0"
  },
  "allowScripts": {
    "electron@45.3.4": true
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
